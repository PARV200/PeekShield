{
  "name": "peekshield-panic-mode",
  "version": "1.0.0",
  "description": "PEEKSHIELD Panic Mode — instantly hide your screen and switch to a safe app",
  "main": "src/main.js",
  "scripts": {
    "start": "node start.js",
    "dev": "node start.js",
    "build": "node build.js",
    "make": "node build.js",
    "test:detector": "python python/detector.py --standalone",
    "test:yunet": "python python/test_yunet.py",
    "test:sface": "python python/test_sface.py",
    "test:gestures": "python python/test_gestures.py",
    "test:pose": "python python/test_head_pose.py",
    "test:risk": "node test_risk_engine.js",
    "test:facttrue": "node test_facttrue.js",
    "run:exe": "node -e \"const {spawn}=require('child_process');const env={...process.env};delete env.ELECTRON_RUN_AS_NODE;spawn('dist/win-unpacked/PEEKSHIELD Panic Mode.exe',[],{env,detached:true,stdio:'ignore'}).unref();\""
  },
  "author": "PEEKSHIELD Team",
  "build": {
    "appId": "com.peekshield.panicmode",
    "productName": "PEEKSHIELD Panic Mode",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "dir"
      ],
      "signAndEditExecutable": false
    },
    "files": [
      "src/**/*",
      "models/**/*",
      "python/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": []
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^28.3.3",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@vladmandic/face-api": "^1.7.15",
    "electron-store": "^8.2.0",
    "node-global-key-listener": "^0.3.0",
    "tesseract.js": "^7.0.0",
    "ws": "^8.22.1"
  },
  "allowScripts": {
    "electron@28.3.3": true
  },
  "optionalDependencies": {
    "robotjs": "^0.9.1"
  }
}
